{
  "name": "@mbeato/agentcontext",
  "version": "0.1.2",
  "description": "Normalize AGENTS.md ↔ CLAUDE.md ↔ .cursor/rules ↔ .clinerules ↔ .windsurf/rules — one source of truth for agent context across IDEs and CLIs.",
  "type": "module",
  "bin": {
    "agentcontext": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ir": "./src/ir.ts",
    "./mcp": "./src/mcp/index.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/cli/index.ts --outfile dist/cli.js --target=node --minify --banner '#!/usr/bin/env node'",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "agents.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "cursor-rules",
    "clinerules",
    "windsurf",
    "aider",
    "ai-coding-agent",
    "mcp"
  ],
  "author": "Max Beato",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbeato/agentcontext.git"
  },
  "homepage": "https://agentsmd.apimesh.xyz",
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
